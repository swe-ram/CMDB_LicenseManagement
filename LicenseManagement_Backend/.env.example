DATABASE_URL=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_ADMIN_TOKEN=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
AUTH_USERNAME=clouddestinations@gmail.com
AUTH_PASSWORD=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
APP_ENV=development
LICENSE_REQUEST_TEST_MODE=false

# ── Approval workflow email (SMTP) ──────────────────────────────────────────
# Never commit real credentials. Configure these only in the local/secret .env.
# Leave EMAIL_ENABLED=false to disable delivery (requests are still saved).
EMAIL_PROVIDER=smtp
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LicenseHub CMDB

# Public base URL of the React portal, used to build links inside emails.
FRONTEND_BASE_URL=http://localhost:3000

